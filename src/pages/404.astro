---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="Not found">
  <section class="page-hero"><div class="container"><p class="eyebrow">404</p>
  <h1>Lost in time</h1>
  <p class="prose" style="margin-top:1rem">That page isn't here. Try the <a href={`${base}/`}>home page</a> or the <a href={`${base}/archive/`}>Time Travel</a>.</p></div></section>
</Base>
