---
import Base from '../layouts/Base.astro';
---
<Base title="Contact">
  <section class="page-hero"><div class="container">
    <div class="page-head"><p class="eyebrow">Contact</p><h1>Get in touch</h1>
      <p>The best place to reach me today is GitHub. More ways to connect are coming soon.</p></div>
    <div class="actions">
      <a class="btn btn-primary" href="https://github.com/Sukonik" rel="noopener">GitHub profile →</a>
      <a class="btn btn-secondary" href="https://github.com/Sukonik/nsukonik/issues" rel="noopener">Open an issue on this site →</a>
    </div>
  </div></section>
</Base>
