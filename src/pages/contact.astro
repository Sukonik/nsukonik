---
import Base from '../layouts/Base.astro';
// Contact details are not rendered or linked in the HTML. They are decoded in the browser only when a button is used,
// so scrapers reading the page source don't get a plain address or number.
const e = 'c3Vrb25pa241MUBnbWFpbC5jb20=';
const p = 'NTE2NDk5NDI1OA==';
---
<Base title="Contact" description="Send Nathan Sukonik a message by email or text.">
  <section class="page-hero"><div class="container">
    <div class="page-head"><p class="eyebrow">Contact</p><h1>Let's talk</h1>
      <p>Working on something, have a question, or just want to say hello? Send me a message by email or text.</p></div>

    <div class="panel" style="max-width:40rem">
      <form id="contact-form" class="form">
        <label>Your name<input name="name" autocomplete="name" required /></label>
        <label>Your email or phone, so I can reply<input name="reply" autocomplete="email" required /></label>
        <label>Message<textarea name="msg" rows="6" required></textarea></label>
        <div class="actions" style="margin-top:.5rem">
          <button class="btn btn-primary" type="submit" data-via="mail">✉️ Send by email</button>
          <button class="btn btn-secondary" type="submit" data-via="sms">💬 Send by text</button>
        </div>
        <p class="meta">Either button opens your own email or messages app with everything filled in, ready to send. This website doesn't send or store anything.</p>
      </form>
    </div>

    <p class="meta" style="margin-top:2rem">Code and projects: <a class="link-arrow" href="https://github.com/Sukonik" rel="noopener">github.com/Sukonik</a></p>
  </div></section>

  <script is:inline define:vars={{ e, p }}>
    var form = document.getElementById('contact-form'), via = 'mail';
    form.querySelectorAll('button[type=submit]').forEach(function (b) { b.addEventListener('click', function () { via = b.dataset.via; }); });
    form.addEventListener('submit', function (ev) {
      ev.preventDefault();
      var d = new FormData(form), name = d.get('name'), reply = d.get('reply');
      var body = d.get('msg') + '\n\n' + name + ' (' + reply + ')';
      location.href = via === 'sms'
        ? 'sms:+1' + atob(p) + '?&body=' + encodeURIComponent(body)
        : 'mailto:' + atob(e) + '?subject=' + encodeURIComponent('Hello from nsukonik.com, ' + name) + '&body=' + encodeURIComponent(body);
    });
  </script>
</Base>
