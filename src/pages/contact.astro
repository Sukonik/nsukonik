---
import Base from '../layouts/Base.astro';
const email = 'sukonikn51@gmail.com';
const phone = '5164994258';
const phoneNice = '(516) 499-4258';
---
<Base title="Contact" description="Email or text Nathan Sukonik.">
  <section class="page-hero"><div class="container">
    <div class="page-head"><p class="eyebrow">Contact</p><h1>Let's talk</h1>
      <p>Working on something, have a question, or just want to say hello? Email or text works best.</p></div>

    <div class="card-grid contact-grid">
      <a class="card" href={`mailto:${email}`}>
        <div class="card-top"><h3>✉️ Email</h3><span class="badge">Best for details</span></div>
        <p class="tag">{email}</p><p class="desc">Opens your email app with a new message to me.</p>
        <p class="links"><span>Send an email →</span></p>
      </a>
      <a class="card" href={`sms:+1${phone}`}>
        <div class="card-top"><h3>💬 Text</h3><span class="badge">Quick questions</span></div>
        <p class="tag">{phoneNice}</p><p class="desc">Opens your messages app. Works best on a phone.</p>
        <p class="links"><span>Send a text →</span></p>
      </a>
    </div>

    <div class="panel" style="margin-top:2rem;max-width:40rem">
      <h2>Write a message</h2>
      <form id="contact-form" class="form">
        <label>Your name<input name="name" autocomplete="name" required /></label>
        <label>Your email or phone<input name="reply" autocomplete="email" required /></label>
        <label>Message<textarea name="msg" rows="5" required></textarea></label>
        <div class="actions" style="margin-top:.5rem">
          <button class="btn btn-primary" type="submit" data-via="mail">Send by email →</button>
          <button class="btn btn-secondary" type="submit" data-via="sms">Send by text →</button>
        </div>
        <p class="meta">This opens your own email or messages app with everything filled in. Nothing is sent or stored by this website.</p>
      </form>
    </div>

    <p class="meta" style="margin-top:2rem">Code and projects: <a class="link-arrow" href="https://github.com/Sukonik" rel="noopener">github.com/Sukonik</a></p>
  </div></section>

  <script is:inline define:vars={{ email, phone }}>
    var form = document.getElementById('contact-form'), via = 'mail';
    form.querySelectorAll('button[type=submit]').forEach(function (b) { b.addEventListener('click', function () { via = b.dataset.via; }); });
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var d = new FormData(form), name = d.get('name'), reply = d.get('reply'), msg = d.get('msg');
      var body = msg + '\n\n' + name + ' (' + reply + ')';
      location.href = via === 'sms'
        ? 'sms:+1' + phone + '?&body=' + encodeURIComponent(body)
        : 'mailto:' + email + '?subject=' + encodeURIComponent('Hello from nsukonik.com, ' + name) + '&body=' + encodeURIComponent(body);
    });
  </script>
</Base>
