---
import Base from '../layouts/Base.astro';
import { archiveEntries, restorationQueue, statusLabel } from '../data/archive';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const now = new Date().getFullYear();
const years = [...new Set([...archiveEntries.map((e) => e.year), now])].sort((a, b) => a - b);
const entries = [...archiveEntries].sort((a, b) => a.year - b.year);
const last = years[years.length - 1];
---
<Base title="Time Travel" description="Travel through the history of nsukonik.com by year.">
  <section class="page-hero"><div class="container">
    <div class="page-head"><p class="eyebrow">Time Travel</p><h1>The original nsukonik.com</h1>
      <p>Slide between years. Archived material is always labeled and never mixed with new writing.</p></div>

    <div class="panel tm" aria-label="Year navigator">
      <p class="tm-year" id="tm-year" aria-live="polite">{last}</p>
      <label for="tm-range">Year</label>
      <input id="tm-range" type="range" min="0" max={years.length - 1} step="1" value={years.length - 1} aria-valuetext={String(last)} />
      <div class="tm-ticks" aria-hidden="true">{years.map((y) => <span>{y}</span>)}</div>
      {years.map((y) => (
        <div class="tm-panel" data-year={y} hidden={y !== last}>
          {y === now
            ? <p class="prose">{y} is today. New writing lives under <a class="link-arrow" href={`${base}/writing/`}>Writing</a>; restoration progress is below.</p>
            : entries.filter((e) => e.year === y).map((e) => (
                <article class="card"><div class="card-top"><h3>{e.title}</h3><span class="badge">Archived · {statusLabel[e.status]}</span></div>
                  {e.snapshotTimestamp && <p class="meta">Captured {e.snapshotTimestamp}</p>}
                  {e.note && <p class="desc">{e.note}</p>}
                  <p class="links">{e.waybackUrl && <a href={e.waybackUrl} rel="noopener">Open the Wayback capture →</a>}</p></article>))}
        </div>
      ))}
    </div>
    <noscript><ul class="timeline">{entries.map((e) => <li><h3>{e.year} · {e.title}</h3><p><a href={e.waybackUrl}>Wayback capture</a></p></li>)}</ul></noscript>
  </div></section>

  <section class="section"><div class="container">
    <div class="page-head"><p class="eyebrow">Restoration</p><h2>In progress</h2>
      <p>Original articles and images are being recovered from the Internet Archive and checked one by one. Anything not recovered is marked missing or partial, never filled in.</p></div>
    <p class="meta" style="margin-bottom:.75rem">Sections queued for review (unverified)</p>
    <ul class="tags">{restorationQueue.map((q) => <li>{q}</li>)}</ul>
    <div style="margin-top:3rem;display:flex;gap:1.25rem;align-items:center;flex-wrap:wrap">
      <img class="legacy-logo" src={`${base}/legacy/nsukonik-logo-1.png`} alt="Legacy nsukonik logo: illustrated head with red hair and glasses on a green background" width="96" height="96" />
      <p class="meta" style="max-width:26rem">The original mark, preserved as the reference. A redesign is a separate task.</p>
    </div>
  </div></section>

  <script is:inline define:vars={{ years }}>
    var r = document.getElementById('tm-range'), y = document.getElementById('tm-year');
    r.addEventListener('input', function () {
      var v = years[+r.value]; y.textContent = v; r.setAttribute('aria-valuetext', String(v));
      document.querySelectorAll('.tm-panel').forEach(function (p) { p.hidden = +p.dataset.year !== v; });
    });
  </script>
</Base>
