---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  const posts = (await getCollection('writing')).filter((p) => !p.data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
---
<Base title={post.data.title} description={post.data.summary}>
  <section class="page-hero"><div class="container">
  <p class="eyebrow">Writing</p>
  <h1>{post.data.title}</h1>
  <p class="meta"><time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('en-US', { dateStyle: 'long', timeZone: 'UTC' })}</time></p>
  <div class="prose"><Content /></div>
  </div></section>
</Base>
