---
import Base from '../layouts/Base.astro';
import { projects } from '../data/projects';
import { getCollection } from 'astro:content';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const featured = [...projects].sort((a, b) => a.name.localeCompare(b.name)).slice(0, 3);
const posts = (await getCollection('writing')).filter((p) => !p.data.draft).sort((a, b) => +b.data.date - +a.data.date).slice(0, 3);
---
<Base title="Home">
  <p class="eyebrow">Personal site · 2026 edition</p>
  <h1>Nathan Sukonik</h1>
  <p class="lede">Work, writing, and a time machine back to where it started. The company and products live at GoldenSunAI; this is the personal home and the archive.</p>
  <p><a class="btn" href={`${base}/archive/`}>Enter the Time Machine</a> <a class="btn ghost" href={`${base}/work/`}>See the work</a></p>

  <h2>Featured work</h2>
  <div class="grid">
    {featured.map((p) => (
      <article class="card"><h3>{p.name}</h3><p class="status">{p.status}</p><p class="cat">{p.category}</p><p>{p.description}</p>
        {p.liveUrl && <a href={p.liveUrl} rel="noopener">Visit live site</a>}</article>
    ))}
  </div>

  <h2>Recent writing</h2>
  {posts.length === 0
    ? <p class="note">New writing is coming. Meanwhile the original articles are being restored in the archive.</p>
    : <ul>{posts.map((p) => <li><a href={`${base}/writing/${p.id}/`}>{p.data.title}</a></li>)}</ul>}

  <h2>Explore the original site</h2>
  <p>The 2018 version of nsukonik.com is being restored page by page. Anything not yet recovered is marked as such.</p>
</Base>
