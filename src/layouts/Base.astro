---
import '../styles/themes.css';
import '../styles/global.css';
import { nav } from '../data/nav';
import { themes, defaultTheme } from '../data/themes';

interface Props { title: string; description?: string; }
const { title, description = 'Nathan Sukonik: founder of GoldenSunAI. Selected work, writing, and the original nsukonik.com restored.' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (p: string) => `${base}/${p}`;
const path = Astro.url.pathname;
const isCurrent = (p: string) => p !== '' && path.startsWith(href(p));
const canonical = new URL(path, Astro.site);
const fullTitle = path === href('') ? 'Nathan Sukonik · Founder, GoldenSunAI' : `${title} · Nathan Sukonik`;
---
<!doctype html>
<html lang="en" data-theme={defaultTheme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#060504" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={href('favicon.svg')} type="image/svg+xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <script is:inline define:vars={{ defaultTheme }}>
      try { document.documentElement.dataset.theme = localStorage.getItem('theme') || defaultTheme; } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container">
        <a class="brand" href={href('')}><span class="gem" aria-hidden="true"></span><span>Nathan <span class="accent">Sukonik</span></span></a>
        <nav class="nav" aria-label="Primary">
          <ul>{nav.map((n) => <li><a href={href(n.href)} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a></li>)}</ul>
        </nav>
        <div class="controls">
          <div class="theme">
            <button class="theme-btn" type="button" aria-haspopup="listbox" aria-expanded="false" aria-controls="theme-menu" aria-label="Choose gem theme">
              <span class="dot" id="theme-dot"></span><span id="theme-name">Sunstone</span><span class="caret" aria-hidden="true"></span>
            </button>
            <div class="theme-menu" id="theme-menu" role="listbox" aria-label="Gem theme" data-open="false">
              {themes.map((t) => <button type="button" role="option" aria-selected="false" data-id={t.id} data-name={t.name} data-c={t.strong}><span class="dot" style={`--c:${t.strong}`}></span>{t.name}</button>)}
            </div>
          </div>
          <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="drawer" aria-label="Open menu"><i></i><i></i><i></i></button>
        </div>
      </div>
    </header>
    <div class="drawer" id="drawer" data-open="false">
      <ul>{nav.map((n) => <li><a href={href(n.href)} aria-current={isCurrent(n.href) ? 'page' : undefined}><span>{n.label}</span></a></li>)}</ul>
    </div>

    <main id="main"><slot /></main>

    <footer class="site-footer">
      <div class="container">
        <div><a class="brand" href={href('')}><span class="gem" aria-hidden="true"></span><span>Nathan <span class="accent">Sukonik</span></span></a>
          <p style="margin-top:.5rem">© {new Date().getFullYear()} Nathan Sukonik. Built with Team GoldenSun. ☀️</p></div>
        <ul>
          <li><a href="https://sukonik.github.io/goldensunai/" rel="noopener">GoldenSunAI</a></li>
          <li><a href="https://github.com/Sukonik" rel="noopener">GitHub</a></li>
          <li><a href={href('archive/')}>Time Travel</a></li>
        </ul>
      </div>
    </footer>

    <script>
      const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
      const toggle = $('.nav-toggle'), drawer = $('#drawer');
      const setDrawer = (o: boolean) => {
        drawer.dataset.open = String(o); toggle.setAttribute('aria-expanded', String(o));
        toggle.setAttribute('aria-label', o ? 'Close menu' : 'Open menu'); document.body.style.overflow = o ? 'hidden' : '';
      };
      toggle.addEventListener('click', () => setDrawer(drawer.dataset.open !== 'true'));
      matchMedia('(min-width: 52.01rem)').addEventListener('change', (e) => e.matches && setDrawer(false));

      const btn = $('.theme-btn'), menu = $('#theme-menu');
      const opts = [...menu.querySelectorAll<HTMLButtonElement>('button')];
      const setMenu = (o: boolean) => { menu.dataset.open = String(o); btn.setAttribute('aria-expanded', String(o)); };
      const mark = () => {
        const cur = opts.find((b) => b.dataset.id === document.documentElement.dataset.theme) ?? opts[0];
        opts.forEach((b) => b.setAttribute('aria-selected', String(b === cur)));
        $('#theme-name').textContent = cur.dataset.name!; $('#theme-dot').style.setProperty('--c', cur.dataset.c!);
      };
      btn.addEventListener('click', (e) => { e.stopPropagation(); setMenu(menu.dataset.open !== 'true'); });
      opts.forEach((b) => b.addEventListener('click', () => {
        document.documentElement.dataset.theme = b.dataset.id!;
        try { localStorage.setItem('theme', b.dataset.id!); } catch {}
        mark(); setMenu(false); btn.focus();
      }));
      document.addEventListener('click', (e) => { if (!menu.contains(e.target as Node)) setMenu(false); });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') { setMenu(false); setDrawer(false); } });
      mark();
    </script>
  </body>
</html>
